file(READ "${CMAKE_CURRENT_LIST_DIR}/../scripts/vela_workbench_labels.json" _vela_sds_labels)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_LIST_DIR}/../scripts/vela_workbench_labels.json")

function(vela_label_sds_case test_name)
    set(labels)
    string(TOLOWER "${test_name}" normalized_test_name)
    string(JSON count LENGTH "${_vela_sds_labels}")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON device MEMBER "${_vela_sds_labels}" ${index})
        string(JSON pattern GET "${_vela_sds_labels}" "${device}")
        if(normalized_test_name MATCHES "${pattern}")
            list(APPEND labels "${device}")
        endif()
    endforeach()
    list(LENGTH labels count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected exactly one SDS device label for ${test_name}")
    endif()
    set_property(TEST "${test_name}" APPEND PROPERTY LABELS ${labels})
endfunction()
