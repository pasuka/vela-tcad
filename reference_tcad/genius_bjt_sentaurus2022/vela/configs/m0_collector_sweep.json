{
  "_comment": "Genius BJT M0: collector sweep from the accepted VBE=0.70 V state.",
  "simulation_type": "dc_sweep",
  "mesh_file": "../input/mesh.json",
  "node_doping_file": "../input/doping.csv",
  "materials_file": "../materials_sentaurus2022.json",
  "output_csv": "../../../../build-release/reference_tcad/genius_bjt_sentaurus2022/vela_wp3_wp5/m0_collector.csv",
  "scaling": {
    "mode": "unit_scaling"
  },
  "doping": [
    {
      "region": "R.Silicon",
      "donors": 5000000000000000.0,
      "acceptors": 0.0
    }
  ],
  "contacts": [
    {
      "name": "emitter",
      "type": "ohmic",
      "bias": 0.0
    },
    {
      "name": "base",
      "type": "ohmic",
      "bias": 0.7
    },
    {
      "name": "collector",
      "type": "ohmic",
      "bias": 0.0
    }
  ],
  "solver": {
    "method": "gummel_newton",
    "max_iter": 60,
    "reltol": 1e-08,
    "abstol": 1e-09,
    "damping_factor": 1.0,
    "damping_psi": 0.2,
    "line_search": true,
    "warm_start": true,
    "quasi_fermi_reference": "contact_majority",
    "quasi_fermi_update_limit_V": 0.1,
    "mobility": {
      "model": "constant"
    },
    "recombination": [
      "srh"
    ],
    "impact_ionization": {
      "model": "none"
    },
    "handoff": {
      "gummel_max_iter": 20,
      "newton_max_iter": 60,
      "require_gummel_convergence": false,
      "fallback": "none"
    },
    "carrier_row_convergence": {
      "mode": "report",
      "eps_row": 0.001,
      "scale_floor": 1e-30,
      "min_source_scale": 1e-18,
      "min_source_scale_fraction": 0.0
    },
    "continuity_row_scaling": {
      "enabled": true,
      "flux_fraction": 0.0,
      "scale_floor": 1e-30,
      "min_source_scale": 1e-18,
      "min_weight": 1e-12,
      "max_weight": 1e+18
    }
  },
  "sweep": {
    "mode": "iv",
    "contact": "collector",
    "current_contact": "collector",
    "start": 0.0,
    "stop": 3.0,
    "step": 0.1,
    "initial_step": 0.001,
    "min_step": 1e-08,
    "max_step": 0.05,
    "growth_factor": 1.3,
    "shrink_factor": 0.5,
    "max_retries": 20,
    "write_vtk": false,
    "initial_state_file": "../../../../build-release/reference_tcad/genius_bjt_sentaurus2022/vela_wp3_wp5/m0_vbe070_state.h5",
    "write_state_file": "../../../../build-release/reference_tcad/genius_bjt_sentaurus2022/vela_wp3_wp5/m0_vce300_state.h5",
    "diagnostics": {
      "terminal_balance": {
        "enabled": true,
        "contacts": [
          "collector",
          "base",
          "emitter"
        ],
        "csv_file": "../../../../build-release/reference_tcad/genius_bjt_sentaurus2022/vela_wp3_wp5/m0_collector_terminal_balance.csv"
      }
    }
  },
  "state_format": "hdf5"
}
