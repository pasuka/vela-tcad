        "doping_concentration_basis": "total_impurity",
        "electron_mumin1_m2_V_s": 52.2,
        "hole_mumin1_m2_V_s": 44.9,
        "electron_mumin2_m2_V_s": 52.2,
        "hole_mumin2_m2_V_s": 0.0,
