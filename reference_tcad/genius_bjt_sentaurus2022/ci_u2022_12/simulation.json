        "type": "ohmic",
        "bias": 0.0
      }
    ],
    "solver": {
      "method": "newton",
      "max_iter": 30,
      "reltol": 1e-08,
      "abstol": 1e-09,
      "damping_factor": 1.0,
      "line_search": false,
      "warm_start": true,
      "mobility": {
