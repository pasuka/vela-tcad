        "hole": {
          "tau_min_s": 0.0,
          "tau_max_s": 3e-06,
          "reference_doping_m3": 1e+16,
          "gamma": 1.0
        }
      },
      "impact_ionization": {
        "model": "none"
      },
      "carrier_row_convergence": {
        "mode": "report",
        "eps_row": 0.001,
        "scale_floor": 1e-30,
        "min_source_scale": 1e-18,
        "min_source_scale_fraction": 0.001,
        "min_source_global_fraction": 1e-06,
        "min_carrier_density_m3": 1e+16,
        "min_flux_scale_fraction": 1e-06,
        "min_flux_scale": 0.0,
        "min_newton_max_iter": 200
      },
      "global_continuity_closure": {
        "mode": "report",
        "tolerance": 0.01,
        "source_floor": 1e-14
      },
      "taun": 1e-05,
      "taup": 3e-06,
      "auger_cn_m6_per_s": 2.9e-31,
      "auger_cp_m6_per_s": 1.0279999999999999e-31,
      "auger_with_generation": false,
      "auger_density_dependence": {
        "enabled": true,
        "electron": {
          "enhancement": 3.46667,
          "reference_density_m3": 1e+18
