{
  "schema": "vela.sdevice_sidecar.v1",
  "sentaurus_step_control": true,
  "high_field_gradient_discretization": "transport_cell_vector",
  "solver": {
    "method": "newton",
    "warm_start": true,
    "line_search": false,
    "diagnostic_fermi_node_cache": true,
    "state_variables": "potential_quasi_fermi",
    "quasi_fermi_reference": "contact_basin",
    "quasi_fermi_update_limit_V": 0.0,
    "continuity_row_scaling": {
      "enabled": false
    },
    "srh_density_coupling": "sentaurus_default",
    "region_resolved_interface_assembly": {
      "poisson_charge_node_volume": "signed_transport",
      "transport_edge_geometry": "element_box"
    },
    "mobility": {
      "jacobian_field_derivatives": false,
      "edge_averaging": "element_box_masetti",
      "prepare_box_masetti_lombardi": true
    },
    "carrier_statistics": {
      "sg_formulation": "effective_potential"
    },
    "abstol": 1e-13,
    "carrier_row_convergence": {
      "mode": "report"
    },
    "global_continuity_closure": {
      "mode": "report"
    }
  },
  "sweep": {
    "vtk_fields": [
      "ElectrostaticPotential"
    ],
    "diagnostics": {
      "terminal_balance": {
        "enabled": true,
        "contacts": [
          "source",
          "drain",
          "gate",
          "substrate"
        ]
      }
    }
  },
  "mesh_geometry": {
    "node_volume_policy": "barycentric",
    "require_non_obtuse": false,
    "poisson_permittivity_policy": "cell_material",
    "cell_box_policy": "delaunay_transfer"
  }
}
