{
  "_comment": "Ablation A: only align the constant electron mobility to the Sentaurus O-2018.06 silicon default, 1417 cm^2/(V s).",
  "simulation_type": "dc_sweep",
  "mesh_file": "mesh.json",
  "materials_file": "materials_mu_n_sentaurus2018_legacy_300k.json",
  "output_csv": "outputs/ablations/mu_n/vela_schottky_iv.csv",
  "scaling": { "mode": "unit_scaling" },
  "node_doping_file": "doping.csv",
  "doping": [
    { "region": "R.Silicon", "donors": 1.0000000000000034e16, "acceptors": 0.0 }
  ],
  "contacts": [
    { "name": "cathode", "type": "ohmic", "bias": 0.0 },
    {
      "name": "anode",
      "type": "schottky",
      "barrier_eV": 0.70,
      "electron_surface_recombination_velocity_m_per_s": 4.91e6,
      "hole_surface_recombination_velocity_m_per_s": 2.74e6,
      "emission_model": "thermionic_robin",
      "bias": 0.0
    }
  ],
  "solver": {
    "method": "newton",
    "max_iter": 150,
    "reltol": 1e-5,
    "diagnostics": false,
    "damping_psi": 0.5,
    "max_update": 5.0,
    "quasi_fermi_update_limit_V": 0.0,
    "warm_start": true,
    "recombination": ["srh"]
  },
  "sweep": {
    "mode": "iv",
    "start": 0.0,
    "stop": 0.82,
    "step": 0.02,
    "initial_step": 0.02,
    "write_state_every_point_prefix": "outputs/ablations/mu_n/states/schottky",
    "write_vtk": false,
    "contact": "anode",
    "current_contact": "anode"
  },
  "validation": { "check_contact_quasi_fermi_bias": false }
}
