      "expected_interpretation": "isolates current-parallel electric field from quasi-Fermi-gradient drive"
    },
    {
      "id": "qf_at_contacts",
      "dimension": "contact treatment",
      "hfs_option": "HighFieldSaturation(GradQuasiFermi)",
      "math_options": ["ComputeGradQuasiFermiAtContacts=UseQuasiFermi"],
      "expected_interpretation": "removes the default electric-field substitution in elements touching contacts"
    },
    {
      "id": "no_parallel_boundary",
      "dimension": "interface boundary layer",
      "hfs_option": "HighFieldSaturation(GradQuasiFermi)",
      "math_options": ["-ParallelToInterfaceInBoundaryLayer"],
      "expected_interpretation": "disables the default tangential-field correction in boundary elements"
    },
    {
      "id": "refdens_efield_1e8",
      "dimension": "low-density interpolation",
      "hfs_option": "HighFieldSaturation(GradQuasiFermi)",
      "math_options": [
        "RefDens_eGradQuasiFermi_ElectricField_HFS=1e8",
        "RefDens_hGradQuasiFermi_ElectricField_HFS=1e8"
      ],
      "expected_interpretation": "interpolates the HFS quasi-Fermi-gradient drive toward electric field below 1e8 cm^-3"
    }
