{
  "schema": "vela.simplemos.sdevice.m71_gate_electrostatic_partition_contract.v1",
  "milestone": "M71",
  "status": "draft_before_freeze",
  "objective": "Determine whether the remaining matched-ni high-NWell Id-Vg error growth is carried by gate-induced surface-potential/oxide-drop partition and semiconductor charge response on the already frozen M65/M69 states.",
  "upstream": {
    "required_m69_status": "frozen",
