{
  "format_version": 2,
  "simulation_type": "dc_sweep",
  "mesh_file": "mesh.json",
  "node_doping_file": "doping.csv",
  "materials_file": "materials.json",
  "doping": [],
  "mesh_geometry": {
    "node_volume_policy": "barycentric",
    "require_non_obtuse": false
  },
  "solver": {
    "mobility": {
      "model": "constant",
      "doping_concentration_basis": "total_impurity"
    },
    "recombination": [
      "srh"
    ],
    "impact_ionization": {
      "model": "none"
    },
    "contact_boundary_minority_electron_relaxation": false,
    "srh_doping_dependence": {
      "electron": {
        "tau_min_s": 0.0,
        "tau_max_s": 1e-05,
        "reference_doping_cm3": 1e+16,
        "gamma": 1.0
      },
      "hole": {
        "tau_min_s": 0.0,
        "tau_max_s": 3e-06,
        "reference_doping_cm3": 1e+16,
        "gamma": 1.0
      },
      "enabled": false
    },
    "tau_n_s": 1e-05,
    "tau_p_s": 3e-06,
    "temperature_K": 300.0,
    "method": "newton",
    "max_iter": 30,
    "warm_start": true,
    "quasi_fermi_reference": "contact_majority",
    "quasi_fermi_update_limit_V": 0.1,
    "carrier_row_convergence": {
      "mode": "enforce",
      "eps_row": 0.001,
      "scale_floor": 1e-30,
      "min_source_scale_fraction": 0.0,
      "min_source_scale": 1e-18,
      "min_newton_max_iter": 30
    },
    "continuity_row_scaling": {
      "enabled": true,
      "flux_fraction": 0.0,
      "scale_floor": 1e-30,
      "min_source_scale": 1e-18,
      "min_weight": 1e-12,
      "max_weight": 1e+18
    },
    "global_continuity_closure": {
      "mode": "enforce",
      "tolerance": 0.01,
      "source_floor": 1e-14
    }
  },
  "output_csv": "stage02.csv",
  "contacts": [
    {
      "name": "emitter",
      "bias": 0.0,
      "type": "ohmic"
    },
    {
      "name": "base",
      "bias": 0.7,
      "type": "ohmic"
    },
    {
      "name": "collector",
      "bias": 0.0,
      "type": "ohmic"
    }
  ],
  "sweep": {
    "mode": "iv",
    "contact": "collector",
    "current_contact": "collector",
    "start": 0.0,
    "stop": 3.0,
    "step": 0.1,
    "initial_step": 0.015,
    "min_step": 3e-07,
    "max_step": 0.15000000000000002,
    "growth_factor": 1.35,
    "shrink_factor": 0.5,
    "write_vtk": true,
    "vtk_prefix": "stage02",
    "vtk_format": "vtu",
    "vtk_fields": [
      "ElectrostaticPotential",
      "ElectricField/Vector",
      "SpaceCharge",
      "eDensity",
      "hDensity",
      "eCurrentDensity/Vector",
      "hCurrentDensity/Vector",
      "eQuasiFermiPotential",
      "hQuasiFermiPotential",
      "DopingConcentration",
      "DonorConcentration",
      "AcceptorConcentration",
      "eMobility",
      "hMobility",
      "srhRecombination",
      "ConductionBandEnergy",
      "ValenceBandEnergy",
      "BandGap"
    ],
    "vtk_binary": false,
    "csv_all_contacts": true,
    "write_state_file": "stage02_state.h5",
    "predictor": "linear",
    "initial_state_file": "stage01_state.h5",
    "vtk_bias_points": [
      0.0,
      0.0999999999999,
      0.1,
      0.2,
      0.30000000000000004,
      0.4,
      0.5,
      0.6000000000000001,
      0.7,
      0.8,
      0.8999999999999999,
      0.9999999999990001,
      1.0,
      1.0999999999999999,
      1.2000000000000002,
      1.3,
      1.4,
      1.5,
      1.6,
      1.7,
      1.7999999999999998,
      1.9,
      2.0,
      2.0999999999999996,
      2.1999999999999997,
      2.3000000000000003,
      2.4000000000000004,
      2.5,
      2.6,
      2.7,
      2.8,
      2.9,
      3.0
    ]
  }
}
