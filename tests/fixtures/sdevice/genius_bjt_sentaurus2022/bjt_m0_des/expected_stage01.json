{
  "format_version": 2,
  "simulation_type": "dc_sweep",
  "mesh_file": "mesh.json",
  "node_doping_file": "doping.csv",
  "materials_file": "materials.json",
  "doping": [],
  "mesh_geometry": {
    "node_volume_policy": "barycentric",
    "require_non_obtuse": false
  },
  "solver": {
    "mobility": {
      "model": "constant",
      "doping_concentration_basis": "total_impurity"
    },
    "recombination": [
      "srh"
    ],
    "impact_ionization": {
      "model": "none"
    },
    "srh_doping_dependence": {
      "electron": {
        "tau_min_s": 0.0,
        "tau_max_s": 1e-05,
        "reference_doping_cm3": 1e+16,
        "gamma": 1.0
      },
      "hole": {
        "tau_min_s": 0.0,
        "tau_max_s": 3e-06,
        "reference_doping_cm3": 1e+16,
        "gamma": 1.0
      }
    },
    "tau_n_s": 1e-05,
    "tau_p_s": 3e-06,
    "temperature_K": 300.0,
    "method": "gummel_newton",
    "max_iter": 30
  },
  "output_csv": "stage01.csv",
  "contacts": [
    {
      "name": "emitter",
      "bias": 0.0,
      "type": "ohmic"
    },
    {
      "name": "base",
      "bias": 0.0,
      "type": "ohmic"
    },
    {
      "name": "collector",
      "bias": 0.0,
      "type": "ohmic"
    }
  ],
  "sweep": {
    "mode": "iv",
    "contact": "base",
    "current_contact": "base",
    "start": 0.0,
    "stop": 0.7,
    "step": 0.027999999999999997,
    "initial_step": 0.0007,
    "min_step": 6.999999999999999e-08,
    "max_step": 0.027999999999999997,
    "growth_factor": 1.35,
    "shrink_factor": 0.5,
    "write_vtk": true,
    "vtk_prefix": "stage01",
    "vtk_format": "vtu",
    "vtk_fields": [
      "ElectrostaticPotential",
      "ElectricField/Vector",
      "SpaceCharge",
      "eDensity",
      "hDensity",
      "eCurrentDensity/Vector",
      "hCurrentDensity/Vector",
      "eQuasiFermiPotential",
      "hQuasiFermiPotential",
      "DopingConcentration",
      "DonorConcentration",
      "AcceptorConcentration",
      "eMobility",
      "hMobility",
      "srhRecombination",
      "ConductionBandEnergy",
      "ValenceBandEnergy",
      "BandGap"
    ],
    "vtk_binary": false,
    "csv_all_contacts": true,
    "write_state_file": "stage01_state.h5",
    "predictor": "linear",
    "initial_state_file": "stage00_state.h5",
    "vtk_bias_points": []
  }
}
