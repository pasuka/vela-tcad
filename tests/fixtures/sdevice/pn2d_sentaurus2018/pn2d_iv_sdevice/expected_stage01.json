      "hole_cr_cm3": 2.23e+17,
      "electron_cs_cm3": 3.43e+20,
      "hole_cs_cm3": 6.1e+20,
      "electron_masetti_alpha": 0.68,
      "hole_masetti_alpha": 0.719,
      "electron_masetti_beta": 2.0,
      "hole_masetti_beta": 2.0
    },
    "recombination": [
      "srh"
    ],
    "impact_ionization": {
      "model": "none"
    },
    "bandgap_narrowing": {
      "model": "old_slotboom",
      "coefficient_eV": 0.009,
      "reference_doping_cm3": 1e+17,
      "smoothing": 0.5
    },
    "srh_doping_dependence": {
      "electron": {
        "tau_min_s": 0.0,
        "tau_max_s": 1e-05,
        "reference_doping_cm3": 1e+16,
        "gamma": 1.0
      },
      "hole": {
        "tau_min_s": 0.0,
        "tau_max_s": 3e-06,
        "reference_doping_cm3": 1e+16,
        "gamma": 1.0
      }
    },
    "tau_n_s": 1e-05,
    "tau_p_s": 3e-06,
    "temperature_K": 300.0,
    "method": "gummel_newton",
    "max_iter": 50
  },
  "output_csv": "stage01.csv",
  "contacts": [
    {
      "name": "Anode",
      "bias": 0.0,
      "type": "ohmic"
