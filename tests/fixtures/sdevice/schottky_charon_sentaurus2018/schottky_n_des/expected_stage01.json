{
  "format_version": 2,
  "simulation_type": "dc_sweep",
  "mesh_file": "mesh.json",
  "node_doping_file": "doping.csv",
  "materials_file": "materials.json",
  "doping": [],
  "mesh_geometry": {
    "node_volume_policy": "barycentric",
    "require_non_obtuse": false
  },
  "solver": {
    "mobility": {
      "model": "constant",
      "doping_concentration_basis": "total_impurity"
    },
    "recombination": [
      "srh"
    ],
    "impact_ionization": {
      "model": "none"
    },
    "contact_boundary_minority_electron_relaxation": false,
    "srh_doping_dependence": {
      "electron": {
        "tau_min_s": 0.0,
        "tau_max_s": 1e-05,
        "reference_doping_cm3": 1e+16,
        "gamma": 1.0
      },
      "hole": {
        "tau_min_s": 0.0,
        "tau_max_s": 3e-06,
        "reference_doping_cm3": 1e+16,
        "gamma": 1.0
      },
      "enabled": false
    },
    "tau_n_s": 1e-05,
    "tau_p_s": 3e-06,
    "temperature_K": 300.0,
    "method": "newton",
    "max_iter": 25,
    "warm_start": true,
    "quasi_fermi_reference": "contact_majority",
    "quasi_fermi_update_limit_V": 0.1,
    "carrier_row_convergence": {
      "mode": "enforce",
      "eps_row": 0.001,
      "scale_floor": 1e-30,
      "min_source_scale_fraction": 0.0,
      "min_source_scale": 1e-18,
      "min_newton_max_iter": 25
    },
    "continuity_row_scaling": {
      "enabled": true,
      "flux_fraction": 0.0,
      "scale_floor": 1e-30,
      "min_source_scale": 1e-18,
      "min_weight": 1e-12,
      "max_weight": 1e+18
    },
    "global_continuity_closure": {
      "mode": "enforce",
      "tolerance": 0.01,
      "source_floor": 1e-14
    }
  },
  "output_csv": "stage01.csv",
  "contacts": [
    {
      "name": "anode",
      "bias": 0.0,
      "type": "schottky",
      "emission_model": "thermionic_robin",
      "electron_surface_recombination_velocity_cm_per_s": 4910000.0,
      "hole_surface_recombination_velocity_cm_per_s": 2740000.0,
      "work_function_eV": 4.75
    },
    {
      "name": "cathode",
      "bias": 0.0,
      "type": "ohmic"
    }
  ],
  "sweep": {
    "mode": "iv",
    "contact": "anode",
    "current_contact": "anode",
    "start": 0.0,
    "stop": 1.0,
    "step": 0.05,
    "initial_step": 0.01,
    "min_step": 1e-06,
    "max_step": 0.05,
    "growth_factor": 1.35,
    "shrink_factor": 0.5,
    "write_vtk": true,
    "vtk_prefix": "stage01",
    "vtk_format": "vtu",
    "vtk_fields": [
      "ElectrostaticPotential",
      "ElectricField/Vector",
      "SpaceCharge",
      "eDensity",
      "hDensity",
      "eCurrentDensity/Vector",
      "hCurrentDensity/Vector",
      "eQuasiFermiPotential",
      "hQuasiFermiPotential",
      "DonorConcentration",
      "AcceptorConcentration",
      "DopingConcentration",
      "ConductionBandEnergy",
      "ValenceBandEnergy",
      "BandGap",
      "srhRecombination",
      "eMobility",
      "hMobility"
    ],
    "vtk_binary": false,
    "csv_all_contacts": true,
    "write_state_file": "stage01_state.h5",
    "predictor": "linear",
    "initial_state_file": "stage00_state.h5",
    "vtk_bias_points": []
  }
}
