{
  "$id": "https://vela-tcad.local/schema/vela-simulation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "contacts": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "bias": {
            "type": "number"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "bias"
        ],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "discretization": {
      "additionalProperties": true,
      "properties": {
        "poisson_charge_volume_policy": {
          "enum": [
            "global",
            "material_local"
          ]
        }
      },
      "type": "object"
    },
    "materials_file": {
      "minLength": 1,
      "type": "string"
    },
    "mesh_geometry": {
      "additionalProperties": true,
      "properties": {
        "carrier_transport_couple_profile": {
          "enum": [
            "mesh_default",
            "templates_ldmos_external_averagebox"
          ]
        },
        "external_averagebox_couples_file": {
          "minLength": 1,
          "type": "string"
        },
        "external_averagebox_expected_edges": {
          "minimum": 1,
          "type": "integer"
        },
        "fallback_negative_cotangent": {
          "type": "boolean"
        },
        "node_volume_policy": {
          "enum": [
            "barycentric",
            "mixed_voronoi"
          ]
        },
        "require_non_obtuse": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "mesh_file": {
      "minLength": 1,
      "type": "string"
    },
    "node_doping_file": {
      "minLength": 1,
      "type": "string"
    },
    "output_csv": {
      "minLength": 1,
      "type": "string"
    },
    "simulation_type": {
      "const": "dc_sweep"
    },
    "solver": {
      "additionalProperties": true,
      "allOf": [
        {"anyOf": [
          {"not": {"required": ["state_variables"], "properties": {"state_variables": {"const": "potential_density"}}}},
          {"required": ["coupled_operator", "carrier_statistics"], "properties": {
            "coupled_operator": {"const": "bvmethods_tri3_qf"},
            "carrier_statistics": {"type": "object", "properties": {"model": {"const": "fermi_dirac_joyce_dixon"}}, "required": ["model"]},
            "method": {"enum": ["newton", "poisson_only"]},
            "quasi_fermi_reference": {"const": "none"}, "split_dd_state": {"const": false},
            "quasi_fermi_update_limit_V": {"const": 0}, "quasi_fermi_update_limit_minority_V": {"const": 0}, "max_update": {"const": 0},
            "quasi_fermi_update_limit_mode": {"const": "componentwise_poisson_recorrect"},
            "quasi_fermi_trust_region_growth_factor": {"const": 1},
            "quasi_fermi_trust_region_max_multiplier": {"const": 1},
            "quasi_fermi_trust_region_expansion_threshold": {"const": 0.75},
            "quasi_fermi_trust_region_shrink_factor": {"const": 1},
            "quasi_fermi_trust_region_min_multiplier": {"const": 1},
            "quasi_fermi_recenter_on_initial_state": {"const": false},
            "quasi_fermi_recenter_on_stall": {"const": false},
            "contact_majority_qf_branch_drop_limit_V": {"const": 0},
            "stable_merit_comparison": {"const": false},
            "carrier_row_qualified_stall_acceptance": {"const": false},
            "carrier_regularization_scale": {"const": 0},
            "continuity_row_scaling": {"properties": {"enabled": {"const": false}}},
            "carrier_row_convergence": {"properties": {"recovery": {"anyOf": [{"const": false}, {"const": "off"}, {"type": "object", "properties": {"mode": {"const": "off"}}}]}}},
            "carrier_diagonal_floor": {"anyOf": [{"const": false}, {"type": "object", "properties": {"enabled": {"const": false}}}]},
            "carrier_diagonal_floor_regularization": {"anyOf": [{"const": false}, {"type": "object", "properties": {"enabled": {"const": false}}}]},
            "linear_equilibration": {"properties": {"mode": {"const": "off"}}},
            "jacobian": {"const": "analytic"}
          }}
        ]},
        {"anyOf": [
          {"not": {"required": ["population_update"]}},
          {"required": ["state_variables"], "properties": {"state_variables": {"const": "potential_density"}}}
        ]},
        {"anyOf": [
          {"not": {"required": ["population_derivative_recovery"], "properties": {"population_derivative_recovery": {"const": "automatic"}}}},
          {"required": ["state_variables"], "properties": {"state_variables": {"const": "potential_density"}}}
        ]}
        ,{"anyOf": [
          {"not": {"required": ["population_sg_bootstrap_linearization"], "properties": {"population_sg_bootstrap_linearization": {"const": "floor_adjacent_edges"}}}},
          {"required": ["state_variables", "coupled_operator", "population_update"], "properties": {
            "state_variables": {"const": "potential_density"}, "coupled_operator": {"const": "bvmethods_tri3_qf"},
            "population_sg_current": {"const": "quasi_fermi"},
            "population_update": {"anyOf": [
              {"required": ["minimum_density_cm3"], "properties": {"minimum_density_cm3": {"type": "number", "exclusiveMinimum": 0}}},
              {"required": ["minimum_density_m3"], "properties": {"minimum_density_m3": {"type": "number", "exclusiveMinimum": 0}}}
            ]}
          }}
        ]}
        ,{"anyOf": [
          {"not": {"required": ["population_sg_current"], "properties": {"population_sg_current": {"const": "band_population"}}}},
          {"required": ["state_variables"], "properties": {"state_variables": {"const": "potential_density"}}}
        ]}
      ],
      "properties": {
        "state_variables": {"type": "string", "enum": ["potential_quasi_fermi", "potential_density"], "description": "Nonlinear primary state. Population mode requires explicit BVMethods physics."},
        "population_sg_bootstrap_linearization": {"enum": ["unchanged", "floor_adjacent_edges"], "default": "unchanged", "description": "Opt-in approximate-only SG population feedback freezing on carrier edges touching the configured positive density floor; requires potential_density and quasi_fermi SG."},
        "population_sg_current": {"enum": ["quasi_fermi", "band_population"], "default": "quasi_fermi", "description": "Experimental direct population/ni-band SG arithmetic; band_population requires potential_density."},
        "population_derivative_recovery": {"enum": ["full", "automatic"], "description": "Population only, automatic full-step bootstrap/trial/full derivative recovery; default full."},
        "population_update": {"type": "object", "additionalProperties": false, "properties": {"protection": {"enum": ["local_nonpositive", "fraction_to_boundary"]}, "local_retained_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "fraction_tau": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "minimum_density_cm3": {"type": "number", "minimum": 0}, "minimum_density_m3": {"type": "number", "minimum": 0}}},
        "block_absolute_convergence": {
          "additionalProperties": false,
          "properties": {
            "electron_residual_ceiling": {
              "minimum": 0,
              "type": "number"
            },
            "hole_residual_ceiling": {
              "minimum": 0,
              "type": "number"
            },
            "mode": {
              "enum": [
                "off",
                "enforce"
              ]
            },
            "psi_residual_ceiling": {
              "minimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        },
        "contact_majority_qf_branch_drop_limit_V": {
          "minimum": 0,
          "type": "number"
        },
        "contact_majority_qf_branch_guard_contacts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "impact_ionization": {
          "additionalProperties": true,
          "properties": {
            "coupling_mode": {
              "enum": [
                "self_consistent",
                "postprocess_only"
              ]
            },
            "model": {
              "enum": [
                "none",
                "van_overstraeten",
                "selberherr"
              ]
            }
          },
          "required": [
            "model"
          ],
          "type": "object"
        },
        "max_iter": {
          "minimum": 1,
          "type": "integer"
        },
        "method": {
          "minLength": 1,
          "type": "string"
        },
        "mobility": {
          "additionalProperties": true,
          "properties": {
            "doping_concentration_basis": {
              "enum": [
                "net_doping",
                "total_impurity",
                "cell_reconstructed_total_impurity"
              ]
            },
            "model": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "model",
            "doping_concentration_basis"
          ],
          "type": "object"
        },
        "srh_doping_dependence": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "concentration_basis": {
              "enum": [
                "total_impurity",
                "net_doping"
              ]
            },
            "electron": {
              "$ref": "#/$defs/srhLifetime"
            },
            "hole": {
              "$ref": "#/$defs/srhLifetime"
            }
          },
          "type": "object"
        },
        "legacy_edge_jacobian_steps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transport": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1e-06
            },
            "avalanche": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1e-07
            }
          }
        },
        "coupled_operator": {
          "type": "string",
          "enum": [
            "legacy",
            "bvmethods_tri3_qf"
          ],
          "description": "Explicit coupled DD operator; BVMethods requires its documented Joyce-Dixon, Tri3 and transport contract."
        }
      },
      "required": [
        "method",
        "max_iter",
        "mobility",
        "impact_ionization"
      ],
      "type": "object"
    },
    "sweep": {
      "additionalProperties": true,
      "properties": {
        "contact": {
          "minLength": 1,
          "type": "string"
        },
        "current_contact": {
          "minLength": 1,
          "type": "string"
        },
        "diagnostics": {
          "additionalProperties": true,
          "properties": {
            "bv_process_probe": {
              "additionalProperties": false,
              "properties": {
                "csv_file": {
                  "minLength": 1,
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "poisson_dirichlet_reaction": {
              "additionalProperties": false,
              "properties": {
                "contacts": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array"
                },
                "csv_file": {
                  "minLength": 1,
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "newton_history": {
              "additionalProperties": false,
              "properties": {
                "attempts_csv_file": {
                  "minLength": 1,
                  "type": "string"
                },
                "csv_file": {
                  "minLength": 1,
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "iterations_csv_file": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "external_circuit": {
          "additionalProperties": false,
          "properties": {
            "current_direction": {
              "enum": [
                -1.0,
                1.0
              ]
            },
            "enabled": {
              "type": "boolean"
            },
            "initial_inner_voltage_V": {
              "type": "number"
            },
            "max_bracket_steps": {
              "minimum": 1,
              "type": "integer"
            },
            "max_inner_voltage_step_V": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            "max_iterations": {
              "minimum": 1,
              "type": "integer"
            },
            "mode": {
              "const": "series_resistor"
            },
            "load_line_convergence_mode": {
              "enum": ["enforce", "report"],
              "default": "enforce",
              "description": "Coupled Newton load-line stopping gate; report retains the equation and finite residual diagnostics."
            },
            "residual_tolerance_V": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            "resistance_ohm_um": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            "voltage_tolerance_V": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            "coupled_equation_tolerance": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "coupled_filter_envelope_factor": {
              "type": "number",
              "minimum": 1
            },
            "coupled_initial_outer_step_V": {
              "type": "number",
              "minimum": 0
            },
            "coupled_min_outer_step_V": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "coupled_max_outer_step_V": {
              "type": "number",
              "minimum": 0
            },
            "coupled_outer_growth_factor": {
              "type": "number",
              "minimum": 1
            },
            "coupled_outer_shrink_factor": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "solver": {
              "enum": [
                "nested_scalar",
                "coupled_newton"
              ]
            },
            "coupled_linear_solver": {
              "enum": [
                "direct_bordered",
                "direct_bordered_qr",
                "schur",
                "auto"
              ]
            },
            "coupled_line_search_mode": {
              "enum": [
                "merit",
                "residual_filter",
                "report_only",
                "full_step"
              ]
            },
            "coupled_update_convergence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {"enum": ["off", "report", "enforce", "enforce_joint"]},
                "digits": {"type": "integer", "minimum": 0, "maximum": 15},
                "potential_reference_V": {"type": "number", "exclusiveMinimum": 0},
                "electron_reference_cm3": {"type": "number", "exclusiveMinimum": 0},
                "hole_reference_cm3": {"type": "number", "exclusiveMinimum": 0},
                "contact_reference_V": {"type": "number", "exclusiveMinimum": 0},
                "diagnostic_csv": {"type": "string"}
              }
            },
            "coupled_max_step_retries": {
              "type": "integer",
              "minimum": 0
            },
            "coupled_step_control": {
              "type": "string",
              "enum": ["quasistationary", "legacy_inner_guard"]
            },
            "coupled_continuation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "retry_from_accepted": {
                  "type": "boolean"
                },
                "inner_step_control": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "max_step_V": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "max_step_fraction": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    },
                    "initial_voltage_V": {
                      "type": "number"
                    },
                    "goal_voltage_V": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "required": [
            "mode",
            "resistance_ohm_um"
          ],
          "type": "object"
        },
        "boundary_control": {
          "additionalProperties": false,
          "properties": {
            "adaptive_outer_continuation": {
              "type": "boolean"
            },
            "checkpoint_directory": {
              "minLength": 1,
              "type": "string"
            },
            "evaluation_csv": {
              "minLength": 1,
              "type": "string"
            },
            "predictor_max_step_factor": {
              "minimum": 1.0,
              "type": "number"
            },
            "preferred_max_evaluations": {
              "minimum": 1,
              "type": "integer"
            },
            "resume": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "growth_factor": {
          "minimum": 1.0,
          "type": "number"
        },
        "vtk_field_data": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          },
          "description": "Opt-in VTU metadata. Keys must be ASCII identifiers and cannot replace runner-owned fields."
        },
        "initial_step": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "max_step": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "min_step": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "mode": {
          "enum": [
            "iv",
            "bv_reverse"
          ]
        },
        "shrink_factor": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "start": {
          "type": "number"
        },
        "step": {
          "not": {
            "const": 0.0
          },
          "type": "number"
        },
        "stop": {
          "type": "number"
        },
        "voltage_to_current": {
          "additionalProperties": false,
          "properties": {
            "current_direction": {
              "enum": [
                -1.0,
                1.0
              ]
            },
            "current_points_A_per_um": {
              "items": {
                "minimum": 0.0,
                "type": "number"
              },
              "minItems": 1,
              "type": "array"
            },
            "current_tolerance_A_per_um": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            "enabled": {
              "type": "boolean"
            },
            "max_bracket_steps": {
              "minimum": 1,
              "type": "integer"
            },
            "max_inner_voltage_step_V": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            "max_iterations": {
              "minimum": 1,
              "type": "integer"
            },
            "switch_voltage_V": {
              "type": "number"
            },
            "voltage_tolerance_V": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            }
          },
          "required": [
            "switch_voltage_V",
            "current_points_A_per_um"
          ],
          "type": "object"
        },
        "write_state_every_point_prefix": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "mode",
        "contact",
        "current_contact",
        "start",
        "stop",
        "step",
        "initial_step",
        "min_step",
        "max_step",
        "growth_factor",
        "shrink_factor"
      ],
      "type": "object"
    },
    "current_contact": {
      "type": "string",
      "minLength": 1,
      "description": "Explicit terminal for newton_solve_from_state current_total_A_per_um; separate from sweep.current_contact."
    }
  },
  "required": [
    "simulation_type",
    "mesh_file",
    "node_doping_file",
    "materials_file",
    "output_csv",
    "contacts",
    "solver",
    "sweep"
  ],
  "title": "Vela simulation configuration",
  "type": "object",
  "$defs": {
    "srhLifetime": {
      "additionalProperties": false,
      "properties": {
        "tau_min_s": {
          "minimum": 0.0,
          "type": "number"
        },
        "tau_max_s": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "reference_doping_m3": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "reference_doping_cm3": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "gamma": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        }
      },
      "type": "object"
    }
  }
}
