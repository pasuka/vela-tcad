{
  "$id": "https://vela-tcad.local/schema/vela-simulation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "contacts": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "bias": {
            "type": "number"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "bias"
        ],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "materials_file": {
      "minLength": 1,
      "type": "string"
    },
    "mesh_geometry": {
      "additionalProperties": true,
      "properties": {
        "node_volume_policy": {
          "enum": [
            "barycentric",
            "mixed_voronoi"
          ]
        },
        "require_non_obtuse": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "mesh_file": {
      "minLength": 1,
      "type": "string"
    },
    "node_doping_file": {
      "minLength": 1,
      "type": "string"
    },
    "output_csv": {
      "minLength": 1,
      "type": "string"
    },
    "simulation_type": {
      "const": "dc_sweep"
    },
    "solver": {
      "additionalProperties": true,
      "properties": {
        "block_absolute_convergence": {
          "additionalProperties": false,
          "properties": {
            "electron_residual_ceiling": {
              "minimum": 0,
              "type": "number"
            },
            "hole_residual_ceiling": {
              "minimum": 0,
              "type": "number"
            },
            "mode": {
              "enum": ["off", "enforce"]
            },
            "psi_residual_ceiling": {
              "minimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        },
        "contact_majority_qf_branch_drop_limit_V": {
          "minimum": 0,
          "type": "number"
        },
        "contact_majority_qf_branch_guard_contacts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "impact_ionization": {
          "additionalProperties": true,
          "properties": {
            "coupling_mode": {
              "enum": [
                "self_consistent",
                "postprocess_only"
              ]
            },
            "model": {
              "enum": [
                "none",
                "van_overstraeten",
                "selberherr"
              ]
            }
          },
          "required": [
            "model"
          ],
          "type": "object"
        },
        "max_iter": {
          "minimum": 1,
          "type": "integer"
        },
        "method": {
          "minLength": 1,
          "type": "string"
        },
        "mobility": {
          "additionalProperties": true,
          "properties": {
            "doping_concentration_basis": {
              "enum": [
                "net_doping",
                "total_impurity",
                "cell_reconstructed_total_impurity"
              ]
            },
            "model": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "model",
            "doping_concentration_basis"
          ],
          "type": "object"
        },
        "srh_doping_dependence": {
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "concentration_basis": {
              "enum": ["total_impurity", "net_doping"]
            },
            "electron": {"$ref": "#/$defs/srhLifetime"},
            "hole": {"$ref": "#/$defs/srhLifetime"}
          },
          "type": "object"
        }
      },
      "required": [
        "method",
        "max_iter",
        "mobility",
        "impact_ionization"
      ],
      "type": "object"
    },
    "sweep": {
      "additionalProperties": true,
      "properties": {
        "contact": {
          "minLength": 1,
          "type": "string"
        },
        "current_contact": {
          "minLength": 1,
          "type": "string"
        },
        "diagnostics": {
          "additionalProperties": true,
          "properties": {
            "bv_process_probe": {
              "additionalProperties": false,
              "properties": {
                "csv_file": {
                  "minLength": 1,
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "newton_history": {
              "additionalProperties": false,
              "properties": {
                "attempts_csv_file": {
                  "minLength": 1,
                  "type": "string"
                },
                "csv_file": {
                  "minLength": 1,
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "iterations_csv_file": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "external_circuit": {
          "additionalProperties": false,
          "properties": {
            "current_direction": {"enum": [-1.0, 1.0]},
            "enabled": {"type": "boolean"},
            "initial_inner_voltage_V": {"type": "number"},
            "max_bracket_steps": {"minimum": 1, "type": "integer"},
            "max_inner_voltage_step_V": {"exclusiveMinimum": 0.0, "type": "number"},
            "max_iterations": {"minimum": 1, "type": "integer"},
            "mode": {"const": "series_resistor"},
            "residual_tolerance_V": {"exclusiveMinimum": 0.0, "type": "number"},
            "resistance_ohm_um": {"exclusiveMinimum": 0.0, "type": "number"},
            "voltage_tolerance_V": {"exclusiveMinimum": 0.0, "type": "number"}
          },
          "required": ["mode", "resistance_ohm_um"],
          "type": "object"
        },
        "boundary_control": {
          "additionalProperties": false,
          "properties": {
            "checkpoint_directory": {"minLength": 1, "type": "string"},
            "evaluation_csv": {"minLength": 1, "type": "string"},
            "predictor_max_step_factor": {"minimum": 1.0, "type": "number"},
            "preferred_max_evaluations": {"minimum": 1, "type": "integer"},
            "resume": {"type": "boolean"}
          },
          "type": "object"
        },
        "growth_factor": {
          "exclusiveMinimum": 1.0,
          "type": "number"
        },
        "initial_step": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "max_step": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "min_step": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "mode": {
          "enum": [
            "iv",
            "bv_reverse"
          ]
        },
        "shrink_factor": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "start": {
          "type": "number"
        },
        "step": {
          "not": {
            "const": 0.0
          },
          "type": "number"
        },
        "stop": {
          "type": "number"
        },
        "voltage_to_current": {
          "additionalProperties": false,
          "properties": {
            "current_direction": {"enum": [-1.0, 1.0]},
            "current_points_A_per_um": {
              "items": {"minimum": 0.0, "type": "number"},
              "minItems": 1,
              "type": "array"
            },
            "current_tolerance_A_per_um": {"exclusiveMinimum": 0.0, "type": "number"},
            "enabled": {"type": "boolean"},
            "max_bracket_steps": {"minimum": 1, "type": "integer"},
            "max_inner_voltage_step_V": {"exclusiveMinimum": 0.0, "type": "number"},
            "max_iterations": {"minimum": 1, "type": "integer"},
            "switch_voltage_V": {"type": "number"},
            "voltage_tolerance_V": {"exclusiveMinimum": 0.0, "type": "number"}
          },
          "required": ["switch_voltage_V", "current_points_A_per_um"],
          "type": "object"
        },
        "write_state_every_point_prefix": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "mode",
        "contact",
        "current_contact",
        "start",
        "stop",
        "step",
        "initial_step",
        "min_step",
        "max_step",
        "growth_factor",
        "shrink_factor"
      ],
      "type": "object"
    }
  },
  "required": [
    "simulation_type",
    "mesh_file",
    "node_doping_file",
    "materials_file",
    "output_csv",
    "contacts",
    "solver",
    "sweep"
  ],
  "title": "Vela simulation configuration",
  "type": "object",
  "$defs": {
    "srhLifetime": {
      "additionalProperties": false,
      "properties": {
        "tau_min_s": {"minimum": 0.0, "type": "number"},
        "tau_max_s": {"exclusiveMinimum": 0.0, "type": "number"},
        "reference_doping_m3": {"exclusiveMinimum": 0.0, "type": "number"},
        "gamma": {"exclusiveMinimum": 0.0, "type": "number"}
      },
      "type": "object"
    }
  }
}
