{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vela.sentaurus_device_ir.v1",
  "title": "Vela Sentaurus device IR v1",
  "description": "Deterministic intermediate representation produced by the fail-closed Sentaurus Structure Editor (SDE) frontend in scripts/sentaurus_device_ir.py.",
  "type": "object",
  "required": [
    "schema",
    "source",
    "defines",
    "geometry",
    "materials",
    "contacts",
    "doping",
    "mesh_control",
    "metadata_only"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "vela.sentaurus_device_ir.v1"
    },
    "source": {
      "type": "string",
      "description": "Path of the SDE .cmd file this IR was parsed from."
    },
    "defines": {
      "type": "object",
      "description": "Symbols bound by (define name value) forms.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": [
              "number",
              "string"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "body_id",
              "region",
              "location"
            ],
            "properties": {
              "kind": {
                "const": "body"
              },
              "body_id": {
                "type": "string",
                "pattern": "^body:[0-9]+$"
              },
              "region": {
                "type": "string"
              },
              "location": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "parameters",
              "expression",
              "location"
            ],
            "properties": {
              "kind": {
                "const": "pure_function"
              },
              "parameters": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "expression": {
                "type": "string"
              },
              "location": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "geometry": {
      "type": "object",
      "required": [
        "regions",
        "inserted_vertices"
      ],
      "additionalProperties": false,
      "properties": {
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "shape",
              "lower_left",
              "upper_right",
              "order",
              "boolean_mode",
              "location"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "shape": {
                "enum": [
                  "rectangle"
                ]
              },
              "lower_left": {
                "$ref": "#/definitions/point2d"
              },
              "upper_right": {
                "$ref": "#/definitions/point2d"
              },
              "order": {
                "type": "integer",
                "minimum": 0,
                "description": "Creation order; boolean_mode determines overlap ownership."
              },
              "boolean_mode": {
                "enum": [
                  "ABA",
                  "BAB"
                ]
              },
              "location": {
                "type": "string"
              },
              "fillets": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "corner",
                    "radius_um",
                    "location"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "corner": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "radius_um": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "location": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "inserted_vertices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "location"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "location": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "region",
          "sde_material",
          "vela_material"
        ],
        "additionalProperties": false,
        "properties": {
          "region": {
            "type": "string"
          },
          "sde_material": {
            "type": "string"
          },
          "vela_material": {
            "type": "string"
          }
        }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "pick_points",
          "display",
          "location"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "display": {
            "type": "array"
          },
          "pick_points": {
            "type": "array",
            "description": "Points from (find-edge-id (position ...)) used to select outer boundary edges. May be empty when the SDE file declares a contact set it never assigns; the mesh builder rejects such contacts.",
            "items": {
              "type": "object",
              "required": [
                "x",
                "y",
                "location"
              ],
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "location": {
                  "type": "string"
                }
              }
            }
          },
          "location": {
            "type": "string"
          }
        }
      }
    },
    "doping": {
      "type": "object",
      "required": [
        "profiles",
        "placements",
        "windows"
      ],
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type",
              "species",
              "carrier"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "constant",
                  "gaussian",
                  "general"
                ]
              },
              "species": {
                "type": "string"
              },
              "carrier": {
                "enum": [
                  "donor",
                  "acceptor"
                ]
              },
              "value_cm3": {
                "type": "number",
                "minimum": 0
              },
              "parameters": {
                "type": "object"
              },
              "lateral_type": {
                "enum": [
                  "gauss",
                  "erf"
                ]
              },
              "location": {
                "type": "string"
              },
              "expression": {
                "type": "string",
                "maxLength": 4096
              },
              "expression_tree": {
                "$ref": "#/definitions/generalExpression"
              },
              "default_value_cm3": {
                "type": "number",
                "minimum": 0
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "general"
                    }
                  }
                },
                "then": {
                  "required": [
                    "expression",
                    "expression_tree",
                    "parameters",
                    "default_value_cm3"
                  ]
                }
              }
            ]
          }
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/placement"
          }
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/window"
          }
        }
      }
    },
    "mesh_control": {
      "type": "object",
      "required": [
        "refinement_sizes",
        "refinement_placements",
        "refinement_functions",
        "windows",
        "build"
      ],
      "additionalProperties": false,
      "properties": {
        "refinement_sizes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "max_x",
              "max_y",
              "location"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "max_x": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max_y": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "min_x": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "min_y": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "location": {
                "type": "string"
              }
            }
          }
        },
        "refinement_placements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "refinement",
              "target_kind",
              "target",
              "location"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "refinement": {
                "type": "string"
              },
              "target_kind": {
                "enum": [
                  "region",
                  "window",
                  "material"
                ]
              },
              "target": {
                "type": "string"
              },
              "location": {
                "type": "string"
              }
            }
          }
        },
        "refinement_functions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "refinement",
              "function",
              "arguments",
              "location"
            ],
            "additionalProperties": false,
            "properties": {
              "refinement": {
                "type": "string"
              },
              "function": {
                "enum": [
                  "MaxTransDiff",
                  "MaxGradient",
                  "MaxLenInt"
                ]
              },
              "arguments": {
                "type": "array"
              },
              "variable": {
                "type": "string"
              },
              "interface": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "factor": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 1
              },
              "double_side": {
                "type": "boolean"
              },
              "use_region_names": {
                "type": "boolean"
              },
              "location": {
                "type": "string"
              }
            }
          }
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/window"
          }
        },
        "build": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "engine",
                "prefix"
              ],
              "additionalProperties": false,
              "properties": {
                "engine": {
                  "type": "string"
                },
                "prefix": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "operations": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "axis",
              "coordinate_um",
              "rename",
              "input",
              "output",
              "location"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "mirror"
              },
              "axis": {
                "const": "y"
              },
              "coordinate_um": {
                "const": 0
              },
              "rename": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "input": {
                "type": "string"
              },
              "output": {
                "type": "string"
              },
              "location": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "metadata_only": {
      "type": "array",
      "description": "Commands recognised but not translated into IR semantics.",
      "items": {
        "type": "object",
        "required": [
          "command",
          "location",
          "text",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "point2d": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "window": {
      "type": "object",
      "required": [
        "name",
        "shape",
        "location"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "shape": {
          "enum": [
            "rectangle",
            "line",
            "polygon"
          ]
        },
        "lower_left": {
          "$ref": "#/definitions/point2d"
        },
        "upper_right": {
          "$ref": "#/definitions/point2d"
        },
        "start": {
          "$ref": "#/definitions/point2d"
        },
        "end": {
          "$ref": "#/definitions/point2d"
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/definitions/point2d"
          }
        },
        "location": {
          "type": "string"
        }
      }
    },
    "placement": {
      "type": "object",
      "required": [
        "name",
        "profile",
        "target_kind",
        "target",
        "priority",
        "replacement",
        "location"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "region",
            "window",
            "material"
          ]
        },
        "target": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "description": "Evaluation order; replacement determines clearing versus accumulation."
        },
        "replacement": {
          "enum": [
            "Replace",
            "LocalReplace",
            "NoReplace"
          ]
        },
        "decay_length": {
          "type": "number",
          "minimum": 0
        },
        "decay": {
          "enum": [
            "none",
            "gaussian",
            "erf"
          ]
        },
        "direction": {
          "enum": [
            "Positive",
            "Negative",
            "Both"
          ]
        },
        "evaluation": {
          "enum": [
            "Eval",
            "NoEval"
          ]
        },
        "restriction_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "restriction": {
          "type": [
            "string",
            "null"
          ]
        },
        "restriction_decay_length": {
          "type": "number",
          "minimum": 0
        },
        "restriction_decay": {
          "enum": [
            "none",
            "gaussian",
            "erf"
          ]
        },
        "location": {
          "type": "string"
        }
      }
    },
    "generalExpression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value"
          ],
          "properties": {
            "op": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "name"
          ],
          "properties": {
            "op": {
              "const": "symbol"
            },
            "name": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "add",
                "sub",
                "mul",
                "div",
                "pow"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/definitions/generalExpression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "neg",
                "pos",
                "abs",
                "exp",
                "sqrt",
                "log"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/definitions/generalExpression"
              }
            }
          }
        }
      ]
    }
  }
}
