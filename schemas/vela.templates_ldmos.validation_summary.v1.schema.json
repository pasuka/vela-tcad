{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.local/schemas/vela.templates_ldmos.validation_summary.v1.schema.json",
  "title": "Templates/LDMOS validation summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "benchmark", "generated_at", "status", "highest_level", "gates", "evidence"],
  "properties": {
    "schema": {"const": "vela.templates_ldmos.validation_summary.v1"},
    "benchmark": {"const": "sentaurus_t2022_03_sp2_templates_ldmos"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pass", "bounded_pass", "fail", "unresolved", "not_run"]},
    "highest_level": {"enum": ["none", "L0", "L1", "L2", "L3", "L4", "L5", "L6", "L7"]},
    "oracle": {"$ref": "#/$defs/gate"},
    "structure": {"$ref": "#/$defs/gate"},
    "budget": {"$ref": "#/$defs/gate"},
    "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "bounded_pass", "fail", "unresolved", "not_run"]},
        "summary": {"type": "string"},
        "metrics": {"type": "object", "additionalProperties": {"type": ["number", "integer", "string", "boolean", "null"]}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "description": {"type": "string"}
      }
    }
  }
}
