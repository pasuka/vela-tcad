{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.local/schemas/vela.templates_ldmos.discretization_contract.v2.schema.json",
  "title": "Templates LDMOS discretization contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "benchmark", "revision", "profile_name", "applicable_mesh",
    "scope", "current_support", "control_volume",
    "poisson_charge_volume", "continuity_source_volume",
    "poisson_edge_support", "field_recovery", "volume_source_mapping",
    "contact_edge_integration", "obtuse_policy", "non_delaunay_policy",
    "avalanche_profile", "atomic_constraints", "forbidden_inference",
    "physics_use_authorized", "status"
  ],
  "properties": {
    "schema": {"const": "vela.templates_ldmos.discretization_contract.v2"},
    "benchmark": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 2},
    "profile_name": {"const": "templates_ldmos_exact_topology_phase_a_classical_v2"},
    "applicable_mesh": {"type": "string", "minLength": 1},
    "scope": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["stage_1_5", "L2", "L3"]}
    },
    "current_support": {
      "const": "scharfetter_gummel_edge_flux_external_averagebox_couple"
    },
    "control_volume": {"const": "mesh_barycentric"},
    "poisson_charge_volume": {
      "const": "transport_material_local_barycentric"
    },
    "continuity_source_volume": {"const": "mesh_barycentric"},
    "poisson_edge_support": {
      "const": "mesh_default_edge_average_epsilon_cotangent_fallback"
    },
    "field_recovery": {"const": "cell_reconstructed"},
    "volume_source_mapping": {"const": "cell_reconstructed_unchanged"},
    "contact_edge_integration": {
      "const": "exact_imported_contact_boundary_edges"
    },
    "obtuse_policy": {
      "const": "accepted_and_listed_with_barycentric_positive_control_volumes"
    },
    "non_delaunay_policy": {"const": "qualified_for_phase_a_classical_only"},
    "avalanche_profile": {"const": "not_authorized_in_phase_a"},
    "atomic_constraints": {
      "type": "array", "minItems": 3, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_inference": {"type": "string", "minLength": 1},
    "physics_use_authorized": {"const": true},
    "status": {"const": "qualified_for_phase_a_classical_stage3"}
  }
}
