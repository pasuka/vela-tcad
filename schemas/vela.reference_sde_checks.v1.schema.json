{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vela.reference_sde_checks.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "vela.reference_sde_checks.v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "mesh_case": {
            "enum": [
              "pn2d",
              "schottky",
              "gate_reference"
            ]
          },
          "command": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(reference_tcad|share)/[A-Za-z0-9_./-]+$"
              },
              "sha256_lf": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256_lf"
            ]
          },
          "parameter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(reference_tcad|share)/[A-Za-z0-9_./-]+$"
              },
              "sha256_lf": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "policy": {
                "enum": [
                  "reference_parameter_file",
                  "explicit_default_for_check_only"
                ]
              }
            },
            "required": [
              "path",
              "sha256_lf",
              "policy"
            ]
          },
          "sidecar": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(reference_tcad|share)/[A-Za-z0-9_./-]+$"
                  },
                  "sha256_lf": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256_lf"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "stage_kinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "equilibrium",
                "sweep"
              ]
            }
          },
          "expected_materials": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "contacts": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "ohmic",
                    "metal_gate",
                    "schottky"
                  ]
                },
                "work_function_eV": {
                  "type": "number"
                },
                "emission_model": {
                  "const": "thermionic_robin"
                },
                "electron_surface_recombination_velocity_cm_per_s": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "hole_surface_recombination_velocity_cm_per_s": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "type"
              ]
            }
          }
        },
        "required": [
          "id",
          "mesh_case",
          "command",
          "parameter",
          "sidecar",
          "stage_kinds",
          "expected_materials",
          "contacts"
        ]
      }
    }
  },
  "required": [
    "schema",
    "cases"
  ]
}
