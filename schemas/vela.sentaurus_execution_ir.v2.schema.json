{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vela.sentaurus_execution_ir.v2",
  "title": "Vela Sentaurus Device execution IR v2",
  "description": "Contract C1 of the SDevice cmd direct-run plan (docs/superpowers/plans/2026-09-26-sdevice-cmd-direct-run-development-plan.md, section 10.0). Produced by the WP1 cmd parser from the command-file text alone: no file-system probing, no mesh or .par knowledge. Every unsupported or ignored construct is reported as a finding with a stable message id (docs/sentaurus_sdevice_workflow.md, message catalogue) and a 1-based source line. Golden documents live in tests/fixtures/sdevice/<case>/*.ir.json.",
  "type": "object",
  "required": [
    "schema",
    "source",
    "verdict",
    "preprocessor_findings",
    "errors",
    "warnings",
    "files",
    "electrodes",
    "physics",
    "plot",
    "current_plot",
    "math",
    "solve",
    "stages",
    "analysis"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "vela.sentaurus_execution_ir.v2"},
    "source": {
      "type": "object",
      "required": ["path", "sha256", "line_count", "syntax_version"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Command file path as given on the command line. Golden fixtures store the base name only."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the command-file bytes after removing a UTF-8 BOM and normalising CRLF to LF, so the value is identical on Windows and Linux checkouts."
        },
        "line_count": {"type": "integer", "minimum": 1},
        "syntax_version": {
          "type": "string",
          "description": "SDevice syntax the parser targets, e.g. T-2022.03."
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["accepted", "exit_code", "fatal_ids"],
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "boolean",
          "description": "True when errors[] and preprocessor_findings[] are both empty."
        },
        "exit_code": {
          "type": "integer",
          "enum": [0, 1, 3],
          "description": "Exit code the orchestrator would use if it stopped after parsing: 0 accepted, 1 input fatal (E1xx), 3 missing input declaration (E301). File-existence checks are not part of the IR."
        },
        "fatal_ids": {
          "type": "array",
          "items": {"$ref": "#/definitions/message_id"},
          "description": "Distinct ids of the findings that made the deck unacceptable, in first-occurrence order."
        }
      }
    },
    "preprocessor_findings": {
      "type": "array",
      "description": "Workbench preprocessor directives (E101), @…@ placeholders (E102) and Tcl !( )! blocks (E103) detected before comment stripping. Non-empty means rejected.",
      "items": {"$ref": "#/definitions/finding"}
    },
    "errors": {
      "type": "array",
      "description": "Fatal findings other than preprocessor ones: E1xx syntax/unsupported constructs and E301 (Parameter keyword missing).",
      "items": {"$ref": "#/definitions/finding"}
    },
    "warnings": {
      "type": "array",
      "description": "Non-fatal findings (W1xx parse warnings). Mapping warnings W2xx are emitted later by the deck emitter and are not part of the IR.",
      "items": {"$ref": "#/definitions/finding"}
    },
    "files": {
      "type": "object",
      "required": ["grid", "parameter", "current", "plot", "output", "ignored"],
      "additionalProperties": false,
      "description": "File{} section after applying the Appendix C (Table 194) naming rule: a base name containing '.' is used literally, otherwise the tool suffix is appended.",
      "properties": {
        "grid": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["raw", "resolved", "kind", "line"],
              "additionalProperties": false,
              "properties": {
                "raw": {"type": "string"},
                "resolved": {"type": "string", "description": "raw with '.tdr' appended when raw has no '.'."},
                "kind": {"enum": ["tdr", "dfise", "unknown"], "description": "dfise = .grd (companion .dat is implied); unknown = other extension (E114)."},
                "line": {"$ref": "#/definitions/line"}
              }
            }
          ]
        },
        "parameter": {
          "oneOf": [
            {"type": "null", "description": "Keyword absent: E301 is recorded in errors[]."},
            {
              "type": "object",
              "required": ["raw", "resolved", "keyword", "line"],
              "additionalProperties": false,
              "properties": {
                "raw": {"type": "string"},
                "resolved": {"type": "string", "description": "raw with '.par' appended when raw has no '.'."},
                "keyword": {"enum": ["Parameter", "Parameters"], "description": "Spelling used in the deck; both are accepted."},
                "line": {"$ref": "#/definitions/line"}
              }
            }
          ]
        },
        "current": {
          "type": "object",
          "required": ["raw", "resolved", "line"],
          "additionalProperties": false,
          "properties": {
            "raw": {"type": ["string", "null"], "description": "null when Current= is absent; resolved then follows the sdevice default derived from the command-file stem."},
            "resolved": {"type": "string", "description": "Base current file name before any NewCurrentPrefix (prefixes are recorded per stage)."},
            "line": {"oneOf": [{"$ref": "#/definitions/line"}, {"type": "null"}]}
          }
        },
        "plot": {
          "type": "object",
          "required": ["raw", "resolved", "vela", "line"],
          "additionalProperties": false,
          "properties": {
            "raw": {"type": ["string", "null"]},
            "resolved": {"type": "string", "description": "Sentaurus name, e.g. x_des.tdr."},
            "vela": {"type": "string", "description": "Vela replacement: resolved with .tdr replaced by .vtu."},
            "line": {"oneOf": [{"$ref": "#/definitions/line"}, {"type": "null"}]}
          }
        },
        "output": {
          "type": "object",
          "required": ["raw", "resolved", "line"],
          "additionalProperties": false,
          "properties": {
            "raw": {"type": ["string", "null"], "description": "null when Output= is absent; resolved is then output_des.log (Table 207 default)."},
            "resolved": {"type": "string", "description": "Observed T-2022.03 behaviour, not the literal Table 194 rule: raw is used verbatim only when it already ends with _des.log, otherwise _des.log is appended even if raw contains a dot (Output=\"pn2d_0v.log\" -> pn2d_0v.log_des.log; Output=\"bjt_m0\" -> bjt_m0_des.log)."},
            "line": {"oneOf": [{"$ref": "#/definitions/line"}, {"type": "null"}]}
          }
        },
        "ignored": {
          "type": "array",
          "description": "Other File{} keys: pure extra outputs are ignored with W107; keys that change physics or inputs are rejected with E1xx and also appear in errors[].",
          "items": {"$ref": "#/definitions/ignored_keyword"}
        }
      }
    },
    "electrodes": {
      "type": "array",
      "description": "Empty only when the deck was rejected before its sections were evaluated (gate 1) or has no Electrode section (E104).",
      "items": {
        "type": "object",
        "required": ["name", "voltage_V", "attributes", "line"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "voltage_V": {"type": "number"},
          "line": {"$ref": "#/definitions/line"},
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "description": "Table 206 attributes that Vela maps. Unsupported attributes are not stored here; they produce E108/E111 in errors[].",
            "properties": {
              "barrier_V": {"type": "number"},
              "workfunction_eV": {"type": "number"},
              "resist_ohm_um": {"type": "number", "description": "Resist= (or the Resistor= alias, W112)."},
              "schottky": {"const": true},
              "e_rec_velocity_cm_s": {"type": "number"},
              "h_rec_velocity_cm_s": {"type": "number"},
              "material": {"type": "string"},
              "poisson": {"const": "Dirichlet"},
              "area_factor": {"const": 1.0}
            }
          }
        }
      }
    },
    "physics": {
      "type": "object",
      "required": ["temperature_K", "global", "scoped", "effective", "fixed_charges"],
      "additionalProperties": false,
      "properties": {
        "temperature_K": {"type": "number", "exclusiveMinimum": 0, "description": "Physics{Temperature=} or the 300 K default."},
        "global": {
          "type": "array",
          "description": "Models written in the unscoped Physics{} block, verbatim (aliases not resolved).",
          "items": {"$ref": "#/definitions/model_entry"}
        },
        "scoped": {
          "type": "array",
          "description": "Physics(Material=|Region=|MaterialInterface=|RegionInterface=) blocks.",
          "items": {
            "type": "object",
            "required": ["scope", "target", "models", "line"],
            "additionalProperties": false,
            "properties": {
              "scope": {"enum": ["Material", "Region", "MaterialInterface", "RegionInterface"]},
              "target": {"type": "string"},
              "models": {"type": "array", "items": {"$ref": "#/definitions/model_entry"}},
              "line": {"$ref": "#/definitions/line"}
            }
          }
        },
        "effective": {
          "type": "array",
          "description": "Canonical effective model set (global union scoped bulk models; section 4.3 rule). Keys are dotted canonical names listed in docs/sentaurus_sdevice_workflow.md section 4.3; aliases such as DopingDep are resolved.",
          "items": {
            "type": "object",
            "required": ["key", "parameters", "status", "vela"],
            "additionalProperties": false,
            "properties": {
              "key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"},
              "parameters": {"type": "object", "description": "Model options that are parameters rather than sub-models, e.g. {\"driving_force\": \"GradQuasiFermi\"}."},
              "status": {"enum": ["supported", "metadata_only", "unsupported"]},
              "vela": {"type": ["string", "null"], "description": "Target Vela deck key/value in the form key=value, or null when not mapped."},
              "finding_id": {"$ref": "#/definitions/message_id"}
            }
          }
        },
        "fixed_charges": {
          "type": "array",
          "description": "Uniform fixed charge from Traps(FixedCharge ...) blocks; every other Traps usage is E106.",
          "items": {
            "type": "object",
            "required": ["scope", "target", "line"],
            "additionalProperties": false,
            "properties": {
              "scope": {"enum": ["Material", "Region", "MaterialInterface", "RegionInterface"]},
              "target": {"type": "string"},
              "conc_cm2": {"type": "number", "description": "Interface blocks."},
              "conc_cm3": {"type": "number", "description": "Bulk insulator blocks."},
              "line": {"$ref": "#/definitions/line"}
            }
          }
        }
      }
    },
    "plot": {
      "type": "object",
      "required": ["explicit", "fields"],
      "additionalProperties": false,
      "properties": {
        "explicit": {"type": "boolean", "description": "True when Math{PlotExplicit} or File{PlotExplicit} suppresses the implicit fields."},
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "data_name", "component", "line"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "description": "As written, without the /Vector or /Element suffix."},
              "data_name": {"type": ["string", "null"], "description": "TDR data name from Appendix F (plan Appendix B); null when the alias is unknown (W104)."},
              "component": {"enum": ["scalar", "vector", "element"]},
              "line": {"$ref": "#/definitions/line"}
            }
          }
        }
      }
    },
    "current_plot": {
      "type": "object",
      "required": ["entries"],
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "description": "Top-level CurrentPlot{} entries. Coordinate sampling and integrals are ignored with W105/W106.",
          "items": {
            "type": "object",
            "required": ["text", "line", "finding_id"],
            "additionalProperties": false,
            "properties": {
              "text": {"type": "string"},
              "line": {"$ref": "#/definitions/line"},
              "finding_id": {"oneOf": [{"$ref": "#/definitions/message_id"}, {"type": "null"}]}
            }
          }
        }
      }
    },
    "math": {
      "type": "object",
      "required": [
        "iterations", "digits", "rel_err_control", "err_ref_electron_cm3", "err_ref_hole_cm3",
        "extrapolate", "derivatives", "aval_derivatives", "compute_ionization_integrals",
        "break_at_ion_integral", "break_criteria", "exit_on_failure", "number_of_threads", "ignored"
      ],
      "additionalProperties": false,
      "description": "Math{} with Table 211 defaults filled in. Values are kept in Sentaurus semantics; the deck emitter maps them.",
      "properties": {
        "iterations": {"type": "integer", "minimum": 1, "default": 50},
        "digits": {"type": "number", "default": 5},
        "rel_err_control": {"type": "boolean", "default": true},
        "err_ref_electron_cm3": {"type": ["number", "null"]},
        "err_ref_hole_cm3": {"type": ["number", "null"]},
        "extrapolate": {"type": "boolean", "default": false},
        "derivatives": {"type": "boolean", "default": true},
        "aval_derivatives": {"type": "boolean", "default": true},
        "compute_ionization_integrals": {"type": "boolean", "default": false},
        "break_at_ion_integral": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["rank", "value"],
              "additionalProperties": false,
              "properties": {
                "rank": {"type": "integer", "minimum": 1},
                "value": {"type": "number"}
              }
            }
          ]
        },
        "break_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "contact", "abs_val_A_per_um", "min_val_A_per_um", "max_val_A_per_um", "line"],
            "additionalProperties": false,
            "properties": {
              "kind": {"const": "Current"},
              "contact": {"type": "string"},
              "abs_val_A_per_um": {"type": ["number", "null"]},
              "min_val_A_per_um": {"type": ["number", "null"]},
              "max_val_A_per_um": {"type": ["number", "null"]},
              "line": {"$ref": "#/definitions/line"}
            }
          }
        },
        "exit_on_failure": {"type": "boolean", "default": false},
        "number_of_threads": {"type": "integer", "minimum": 1, "default": 1},
        "ignored": {
          "type": "array",
          "description": "Recorded-and-ignored keywords (W102) and unknown keywords (W101).",
          "items": {"$ref": "#/definitions/ignored_keyword"}
        }
      }
    },
    "solve": {
      "type": "object",
      "required": ["statements"],
      "additionalProperties": false,
      "properties": {
        "statements": {
          "type": "array",
          "description": "Solve{} statements in source order (syntactic record). Empty only for gate-1 rejected decks or decks without a Solve section (E104).",
          "items": {"$ref": "#/definitions/statement"}
        }
      }
    },
    "stages": {
      "type": "array",
      "description": "Execution-ordered solve stages derived from solve.statements: every Poisson/Coupled/Quasistationary/Save/Load statement becomes one stage; Plot/CurrentPlot/NewCurrentPrefix/Set statements are folded into the stage they affect.",
      "items": {
        "type": "object",
        "required": ["index", "kind", "statement_index", "equations", "current_prefix", "outputs", "depends_on"],
        "additionalProperties": false,
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "kind": {"enum": ["initial", "sweep", "save", "load"]},
          "statement_index": {"type": "integer", "minimum": 0},
          "equations": {"type": "array", "items": {"type": "string"}},
          "iterations": {"type": ["integer", "null"]},
          "goal": {"$ref": "#/definitions/goal"},
          "t_control": {"$ref": "#/definitions/t_control"},
          "current_mode_contacts": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Contacts switched to current mode by Set(\"c\" mode current) before this stage."
          },
          "current_prefix": {"type": "string", "description": "NewCurrentPrefix in force ('' when none)."},
          "outputs": {
            "type": "object",
            "required": ["current_file", "plot_files", "current_plot_times"],
            "additionalProperties": false,
            "properties": {
              "current_file": {"type": "string", "description": "current_prefix + files.current.resolved."},
              "plot_files": {
                "type": "array",
                "description": "Plot statements attached to this stage, with Vela .vtu names.",
                "items": {
                  "type": "object",
                  "required": ["file_prefix", "time", "no_overwrite", "sentaurus_pattern", "vela_pattern"],
                  "additionalProperties": false,
                  "properties": {
                    "file_prefix": {"type": "string"},
                    "time": {"$ref": "#/definitions/time_spec"},
                    "no_overwrite": {"type": "boolean"},
                    "sentaurus_pattern": {"type": "string", "description": "e.g. pn2d_iv_multibias_NNNN_des.tdr; NNNN = global plot index."},
                    "vela_pattern": {"type": "string", "description": "Same with .vtu."}
                  }
                }
              },
              "current_plot_times": {"$ref": "#/definitions/time_spec"}
            }
          },
          "depends_on": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "line": {"$ref": "#/definitions/line"}
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": ["kind", "reason", "sweep_contacts", "final_contact", "final_voltage"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["equilibrium", "iv", "bv", "cv", "multi_stage", "rejected"]},
        "reason": {"type": "string"},
        "sweep_contacts": {"type": "array", "items": {"type": "string"}},
        "final_contact": {"type": ["string", "null"]},
        "final_voltage": {"type": ["number", "null"]}
      }
    }
  },
  "definitions": {
    "line": {"type": "integer", "minimum": 1},
    "message_id": {
      "type": "string",
      "pattern": "^[WE][1-8][0-9]{2}$",
      "description": "Stable message id from the catalogue: W1xx parse warnings, W2xx mapping warnings, E1xx syntax/unsupported, E2xx usage, E3xx files, E4xx validation, E5xx solve, E6xx output, E7xx concurrency, E8xx interrupted."
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "line", "text", "message"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/definitions/message_id"},
        "severity": {"enum": ["fatal", "warning"]},
        "line": {"oneOf": [{"$ref": "#/definitions/line"}, {"type": "null"}]},
        "column": {"type": "integer", "minimum": 1},
        "section": {"type": ["string", "null"], "description": "Enclosing section name (File, Electrode, Physics, Plot, CurrentPlot, Math, Solve, ...) when known."},
        "text": {"type": "string", "description": "Offending source text, trimmed."},
        "message": {"type": "string", "description": "English message from the catalogue, with the token substituted."}
      }
    },
    "ignored_keyword": {
      "type": "object",
      "required": ["keyword", "value", "line", "finding_id"],
      "additionalProperties": false,
      "properties": {
        "keyword": {"type": "string"},
        "value": {"type": ["string", "null"]},
        "line": {"$ref": "#/definitions/line"},
        "finding_id": {"$ref": "#/definitions/message_id"}
      }
    },
    "model_arg": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "value": {"type": ["number", "string", "boolean"], "description": "For key=value options such as Conc=1e11 or Model=NonLocalPath."},
        "args": {"type": "array", "items": {"$ref": "#/definitions/model_arg"}}
      }
    },
    "model_entry": {
      "type": "object",
      "required": ["model", "args", "line"],
      "additionalProperties": false,
      "properties": {
        "model": {"type": "string", "description": "Top-level keyword as written, e.g. Mobility, Recombination, EffectiveIntrinsicDensity, Fermi, eQuantumPotential, Traps."},
        "args": {"type": "array", "items": {"$ref": "#/definitions/model_arg"}},
        "line": {"$ref": "#/definitions/line"}
      }
    },
    "goal": {
      "type": "object",
      "required": ["contact"],
      "additionalProperties": false,
      "properties": {
        "contact": {"type": "string"},
        "voltage_V": {"type": "number"},
        "current_A_per_um": {"type": "number"}
      },
      "oneOf": [
        {"required": ["voltage_V"]},
        {"required": ["current_A_per_um"]}
      ]
    },
    "t_control": {
      "type": "object",
      "description": "Quasistationary step control in the manual's normalised t in [0,1]; values are kept as written, conversion to volts happens in the stage plan.",
      "required": ["initial_step", "min_step", "max_step", "increment", "decrement", "do_zero"],
      "additionalProperties": false,
      "properties": {
        "initial_step": {"type": ["number", "null"]},
        "min_step": {"type": ["number", "null"]},
        "max_step": {"type": ["number", "null"]},
        "increment": {"type": ["number", "null"]},
        "decrement": {"type": ["number", "null"]},
        "do_zero": {"type": "boolean"}
      }
    },
    "time_spec": {
      "oneOf": [
        {"type": "null", "description": "No Time= given: sdevice default (every accepted step for CurrentPlot; end of statement for Plot)."},
        {
          "type": "object",
          "required": ["list"],
          "additionalProperties": false,
          "properties": {"list": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}}}
        },
        {
          "type": "object",
          "required": ["range", "intervals"],
          "additionalProperties": false,
          "properties": {
            "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
            "intervals": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "statement": {
      "type": "object",
      "required": ["kind", "line"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["poisson", "coupled", "quasistationary", "plot", "current_plot", "new_current_prefix", "save", "load", "set", "unsupported"]
        },
        "line": {"$ref": "#/definitions/line"},
        "equations": {"type": "array", "items": {"type": "string"}, "description": "coupled: equation names as written (Poisson, Electron, Hole, eQuantumPotential, ...)."},
        "iterations": {"type": ["integer", "null"]},
        "options": {"type": "object", "description": "Other Coupled(...) options recorded verbatim, e.g. LineSearchDamping."},
        "goal": {"$ref": "#/definitions/goal"},
        "t_control": {"$ref": "#/definitions/t_control"},
        "body": {"type": "array", "items": {"$ref": "#/definitions/statement"}, "description": "quasistationary: inner statements (one coupled plus optional plot/current_plot)."},
        "file_prefix": {"type": "string"},
        "time": {"$ref": "#/definitions/time_spec"},
        "no_overwrite": {"type": "boolean"},
        "prefix": {"type": "string", "description": "new_current_prefix."},
        "contact": {"type": "string", "description": "set."},
        "mode": {"enum": ["current", "voltage"], "description": "set."},
        "text": {"type": "string", "description": "unsupported: offending statement text."},
        "finding_id": {"$ref": "#/definitions/message_id"}
      }
    }
  }
}
