{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vela.sdevice_sidecar.v1",
  "title": "Vela sdevice sidecar override file v1 (contract C10)",
  "description": "Optional <stem>.vela.json placed next to <stem>_des.cmd. It carries Vela-only numerical options that the sdevice command language cannot express (plan section 9, decision 23). Only the whitelisted top-level keys are allowed; electrodes, physics models, sweep goals and file names can never be changed here. The orchestrator deep-merges the sidecar into every generated stage deck after emission (objects merge key by key, arrays and scalars replace) and logs every replaced key with W207. The merged deck must still validate against configs/schema/vela-simulation.schema.json (E409 otherwise).",
  "type": "object",
  "required": ["schema"],
  "additionalProperties": false,
  "anyOf": [
    {"not": {"required": ["bvmethods_statistics"]}},
    {"required": ["bvmethods_operator_profile"]}
  ],
  "properties": {
    "schema": {"const": "vela.sdevice_sidecar.v1"},
    "high_field_gradient_discretization": {
      "enum": ["edge_projection", "transport_cell_vector", "element_box_vertex"],
      "description": "Numerical recovery of an active high-field mobility GradQuasiFermi drive. Sets only solver.mobility.high_field_gradient_discretization; models and coefficients remain owned by cmd/par."
    },
    "avalanche_current_support_profile": {
      "enum": ["element_edge_sg_gss_laux", "legacy_cell_reconstructed"],
      "description": "Explicit atomic PN2D BV current/source/node-volume discretization bundle; does not change avalanche coefficients or model. Requires current-density GradQF avalanche. The element-edge profile requires a qualified non-obtuse mesh."
    },
    "bvmethods_operator_profile": {
      "enum": [
        "bvmethods_tri3_qf"
      ],
      "description": "Explicit qualified 300 K Tri3 numerical operator and Fermi approximation; cmd/par retain physical laws and coefficients. Basic state Plot fields only."
    },
    "bvmethods_statistics": {
      "enum": ["fermi_dirac_joyce_dixon", "fermi_dirac"],
      "description": "Explicit numerical statistics for the BVMethods profile. The default is Joyce-Dixon."
    },
    "sentaurus_step_control": {
      "const": true,
      "description": "Use Newton-work-based voltage step growth and retain the proposed step after landing on an output point. Voltage targets and step bounds come from the CMD."
    },
    "description": {"type": "string"},
    "apply_to": {
      "type": "array",
      "description": "Stage plan indices the overrides apply to; absent or empty means every stage.",
      "items": {"type": "integer", "minimum": 0}
    },
    "stage_newton_reltol": {
      "type": "object",
      "description": "Positive Newton relative residual tolerances keyed by zero-based executable stage index. Omitted stages use solver.reltol. Load does not run Newton.",
      "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
    },
    "stage_vtk_bias_points": {
      "type": "object",
      "description": "Limit runner VTU output for the specified executable stages to existing voltage targets in V. An empty list suppresses VTU output for a stage. Sweep targets and state checkpoints are retained.",
      "additionalProperties": {"type": "array", "items": {"type": "number"}, "uniqueItems": true}
    },
    "solver": {
      "type": "object",
      "description": "Merged into deck.solver. Physics model selections are rejected: the emitter owns mobility/recombination/impact_ionization/bandgap_narrowing/carrier_statistics model choices.",
      "additionalProperties": true,
      "properties": {
        "mobility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "edge_averaging": {"enum": ["auto", "legacy", "element_box", "element_box_masetti"]},
            "contact_electric_field_fallback": {"type": "boolean"},
            "jacobian_field_derivatives": {"type": "boolean"},
            "prepare_box_masetti_lombardi": {"type": "boolean"}
          }
        },
        "carrier_statistics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sg_formulation": {"enum": ["auto", "generalized_einstein", "effective_potential"]}
          }
        },
        "srh_density_coupling": {"enum": ["quantum", "sentaurus_default", "quantum_band_edge"]},
        "electron_quantum_potential": {
          "type": "object",
          "description": "Density-gradient discretization, interface traces and iteration controls. Requires eQuantumPotential in CMD Physics.",
          "additionalProperties": false,
          "properties": {
            "include_insulators": {"type": "boolean"},
            "global_discretization": {"const": "sentaurus_box"},
            "coupling_mode": {"enum": ["outer", "monolithic_box"]},
            "coefficient_mass_ratio": {"type": "number", "exclusiveMinimum": 0},
            "sentaurus_interface_insulator_half_jump_offset": {"type": "number"},
            "sentaurus_interface_insulator_at_silicon_reaction_weight": {"type": "number", "exclusiveMinimum": 0},
            "sentaurus_interface_insulator_at_polysilicon_reaction_weight": {"type": "number", "exclusiveMinimum": 0},
            "damping": {"type": "number", "exclusiveMinimum": 0, "maximum": 1,
                        "description": "Initial line-search scale of the density-gradient inner Newton solve."},
            "outer_absolute_tolerance_V": {"type": "number", "exclusiveMinimum": 0},
            "outer_max_iterations": {"type": "integer", "minimum": 1},
            "max_iterations": {"type": "integer", "minimum": 1}
          }
        }
      },
      "not": {
        "anyOf": [
          {"required": ["recombination"]},
          {"required": ["impact_ionization"]},
          {"required": ["band_to_band"]},
          {"required": ["bandgap_narrowing"]},
          {"required": ["temperature_K"]}
        ]
      }
    },
    "mesh_geometry": {
      "type": "object",
      "description": "Merged into deck.mesh_geometry (node_volume_policy, require_non_obtuse, material_support_policy, ...).",
      "additionalProperties": true
    },
    "discretization": {
      "type": "object",
      "description": "Merged into deck.discretization (poisson_charge_volume_policy, current support profile, ...).",
      "additionalProperties": true
    },
    "sweep": {
      "type": "object",
      "description": "Numerical diagnostics, explicit basic-state output selection and external-circuit solver controls only; physical resistance, electrodes, goals, step schedule and output names remain owned by cmd.",
      "anyOf": [{"required": ["diagnostics"]}, {"required": ["external_circuit"]},
                {"required": ["voltage_to_current"]}, {"required": ["vtk_fields"]}],
      "additionalProperties": false,
      "properties": {
        "vtk_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ElectrostaticPotential", "eDensity", "hDensity", "SpaceCharge", "DopingConcentration"]}, "description": "Explicit basic-state Plot projection, logged with W207. Does not change the CMD, physics, stop rules or output names; omitted fields are not qualified as exported."},
        "diagnostics": {"type": "object", "additionalProperties": true},
        "voltage_to_current": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_inner_voltage_step_V": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "external_circuit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "solver": {
              "enum": [
                "nested_scalar",
                "coupled_newton"
              ]
            },
            "max_iterations": {
              "minimum": 1,
              "type": "integer"
            },
            "physical_acceptance_mode": {"enum": ["enforce", "report"], "description": "Independent load, carrier, continuity and KCL quality gate; default report for native_approx, enforce for legacy. Nonfinite states always reject."},
            "load_line_convergence_mode": {
              "enum": ["enforce", "report"],
              "default": "enforce",
              "description": "Coupled Newton load-line stopping gate; report retains the equation and finite residual diagnostics."
            },
            "residual_tolerance_V": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            "max_inner_voltage_step_V": {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            "coupled_equation_tolerance": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "coupled_filter_envelope_factor": {
              "type": "number",
              "minimum": 1
            },
            "coupled_linear_solver": {
              "enum": [
                "direct_bordered",
                "direct_bordered_qr",
                "schur",
                "full_fd"
              ]
            },
            "coupled_line_search_mode": {
              "enum": [
                "merit",
                "residual_filter",
                "report_only",
                "full_step"
              ]
            },
            "coupled_update_convergence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "off",
                    "report",
                    "enforce",
                    "enforce_joint"
                  ]
                },
                "digits": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                },
                "potential_reference_V": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "electron_reference_cm3": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "hole_reference_cm3": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "contact_reference_V": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "diagnostic_csv": {
                  "type": "string"
                }
              }
            },
            "coupled_max_step_retries": {
              "type": "integer",
              "minimum": 0
            },
            "coupled_step_control": {
              "type": "string",
              "enum": ["quasistationary", "legacy_inner_guard"]
            },
            "coupled_continuation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "retry_from_accepted": {
                  "type": "boolean"
                },
                "inner_step_control": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "max_step_V": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "max_step_fraction": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    },
                    "initial_voltage_V": {
                      "type": "number"
                    },
                    "goal_voltage_V": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "runtime_log": {
      "type": "object",
      "description": "Merged into deck.runtime_log; only the profile may be changed (the file and append mode are fixed by the orchestrator).",
      "required": ["profile"],
      "additionalProperties": false,
      "properties": {
        "profile": {"enum": ["minimal", "default", "debug"]}
      }
    }
  }
}
