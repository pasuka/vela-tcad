{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.local/schemas/vela.templates_ldmos.threshold_freeze.v1.schema.json",
  "title": "Templates/LDMOS threshold freeze v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "benchmark", "revision", "scope", "thresholds", "evidence", "approval"],
  "properties": {
    "schema": {"const": "vela.templates_ldmos.threshold_freeze.v1"},
    "benchmark": {"const": "sentaurus_t2022_03_sp2_templates_ldmos"},
    "revision": {"type": "integer", "minimum": 1},
    "scope": {"enum": ["phase_a_decisions", "phase_b_execution", "final"]},
    "thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "metric", "operator", "value", "unit", "gate_type", "applies_to"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "metric": {"type": "string", "minLength": 1},
          "operator": {"enum": ["<", "<=", ">", ">=", "=="]},
          "value": {"type": "number"},
          "unit": {"type": "string"},
          "gate_type": {"enum": ["hard", "diagnostic", "decision"]},
          "applies_to": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "approval": {"$ref": "#/$defs/approval"}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "benchmark_owner", "independent_reviewer", "approved_at"],
      "properties": {
        "status": {"enum": ["draft", "approved", "rejected", "expired"]},
        "benchmark_owner": {"type": ["string", "null"]},
        "independent_reviewer": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
