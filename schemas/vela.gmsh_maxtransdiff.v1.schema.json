{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vela.gmsh_maxtransdiff.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "transform",
    "edge_rule",
    "stop_rule",
    "mapping",
    "native_snmesh_equivalence",
    "max_iterations",
    "max_nodes",
    "rounds",
    "functions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "vela.gmsh_maxtransdiff.v1"
    },
    "status": {
      "enum": [
        "running",
        "passed",
        "failed"
      ]
    },
    "transform": {
      "type": "string"
    },
    "edge_rule": {
      "type": "string"
    },
    "stop_rule": {
      "type": "string"
    },
    "mapping": {
      "type": "string"
    },
    "native_snmesh_equivalence": {
      "const": false
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 0
    },
    "max_nodes": {
      "type": "integer",
      "minimum": 3
    },
    "remesh_iterations": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "enum": [
        "iteration_budget",
        "node_budget"
      ]
    },
    "observed_nodes": {
      "type": "integer",
      "minimum": 0
    },
    "predicted_nodes": {
      "type": "integer",
      "minimum": 0
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "iteration",
          "nodes",
          "triangles",
          "marked_edges",
          "edges",
          "minimum_stopped_edges",
          "refineable_nodes",
          "max_transformed_difference"
        ],
        "properties": {
          "iteration": {
            "type": "integer",
            "minimum": 0
          },
          "nodes": {
            "type": "integer",
            "minimum": 0
          },
          "triangles": {
            "type": "integer",
            "minimum": 0
          },
          "marked_edges": {
            "type": "integer",
            "minimum": 0
          },
          "edges": {
            "type": "integer",
            "minimum": 0
          },
          "minimum_stopped_edges": {
            "type": "integer",
            "minimum": 0
          },
          "refineable_nodes": {
            "type": "integer",
            "minimum": 0
          },
          "closure_edges": {
            "type": "integer",
            "minimum": 0
          },
          "max_transformed_difference": {
            "type": "number",
            "minimum": 0
          },
          "maxlenint_marked_edges": {
            "type": "integer",
            "minimum": 0
          },
          "multibox_marked_edges": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "functions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refinement",
          "variable",
          "threshold",
          "source_location"
        ],
        "properties": {
          "refinement": {
            "type": "string"
          },
          "variable": {
            "const": "DopingConcentration"
          },
          "threshold": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "source_location": {
            "type": "string"
          }
        }
      }
    }
  }
}
