{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vela.gmsh_transfinite_mesh_contract.v1.schema.json",
  "title": "Vela Gmsh Transfinite mesh contract v1",
  "type": "object",
  "required": [
    "schema",
    "requested_strategy",
    "actual_strategy",
    "diagonal",
    "recombine",
    "element_order",
    "x_coordinates",
    "y_coordinates",
    "x_intervals",
    "y_intervals",
    "expected_node_count",
    "expected_cell_count",
    "surface_count"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "vela.gmsh_transfinite_mesh_contract.v1"},
    "requested_strategy": {"const": "transfinite-rect"},
    "actual_strategy": {"const": "transfinite-rect"},
    "diagonal": {
      "enum": ["Left", "Right", "AlternateLeft", "AlternateRight"]
    },
    "recombine": {"const": false},
    "element_order": {"const": 1},
    "x_coordinates": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "number"}
    },
    "y_coordinates": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "number"}
    },
    "x_intervals": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 1}
    },
    "y_intervals": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 1}
    },
    "expected_node_count": {"type": "integer", "minimum": 4},
    "expected_cell_count": {"type": "integer", "minimum": 2},
    "surface_count": {"type": "integer", "minimum": 1}
  }
}
